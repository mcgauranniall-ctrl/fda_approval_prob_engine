# Copy to .env (git-ignored) or set as user environment variables.

# SEC EDGAR requires a descriptive User-Agent with contact details:
# https://www.sec.gov/os/accessing-edgar-data   e.g. "Your Name your.email@example.com"
SEC_USER_AGENT=

# Optional: raises openFDA rate limits (https://open.fda.gov/apis/authentication/)
OPENFDA_API_KEY=

# Optional: path to the Claude Code CLI if it is not at %USERPROFILE%\.local\bin\claude.exe or on PATH
CLAUDE_EXE=
